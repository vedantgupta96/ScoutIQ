# Copy to .env and fill in. Neon gives this on the project dashboard ("Connection string").
# Note the driver prefix: SQLAlchemy needs postgresql+psycopg (psycopg 3), and Neon needs sslmode=require.
# On a hosting platform, set these as real environment variables instead of a .env file.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/scoutiq?sslmode=require

# Browser origins allowed by CORS, comma-separated. Local dev default shown;
# production adds the deployed frontend, e.g.
# CORS_ORIGINS=http://localhost:3000,https://scoutiq.vercel.app
CORS_ORIGINS=http://localhost:3000

# --- Offline scripts only (Sonar/Claude backfills, eval CLI). NOT required to
# serve the API; the rationale endpoint is the one live exception that uses them.
# PERPLEXITY_API_KEY=
# ANTHROPIC_API_KEY=
# SCOUTIQ_LLM_MODEL=claude-sonnet-4-6

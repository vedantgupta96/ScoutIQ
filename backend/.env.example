# Copy to .env and fill in. Neon gives this on the project dashboard ("Connection string").
# Note the driver prefix: SQLAlchemy needs postgresql+psycopg (psycopg 3), and Neon needs sslmode=require.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/scoutiq?sslmode=require

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# --- Virtual environments (the bulk of the file count) ---
.venv/
venv/
env/

# --- Secrets / local env (NEVER commit) ---
.env
.env.*
!.env.example

# --- Cached BBRef scrape HTML (regenerable; thousands of files) ---
backend/scoutiq/data/raw/

# --- Trained model binaries (regenerable; keep report/plots/metrics) ---
backend/scoutiq/model/artifacts/*.joblib
# The canonical serving model ships with the repo (1.8 MB) so the API can
# deploy without a training step; ad-hoc/experimental joblibs stay ignored.
!backend/scoutiq/model/artifacts/model.joblib

# --- Offline experiment harness output (regenerable; never production) ---
backend/scoutiq/model/experiments/output/

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# --- Local AI-tool state (dev-machine working files, never part of the product) ---
.claude/
.agents/skills/
skills-lock.json
.codex/
.impeccable/
graphify-out/
AGENTS.md
CLAUDE.md

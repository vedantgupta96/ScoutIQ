# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# --- Virtual environments (the bulk of the file count) ---
.venv/
venv/
env/

# --- Secrets / local env (NEVER commit) ---
.env
.env.*
!.env.example

# --- Cached BBRef scrape HTML (regenerable; thousands of files) ---
backend/scoutiq/data/raw/

# --- Trained model binary (regenerable; keep report/plots/metrics) ---
backend/scoutiq/model/artifacts/*.joblib

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# --- Local agent config ---
.claude/
.agents/skills/
.codex/*.local.toml
.codex/config.local.toml
.codex/secrets.toml
.codex/cache/
.codex/logs/

# --- Graphify: keep outputs, skip regenerable cache + working files ---
graphify-out/.graphify_*
graphify-out/.graphify_chunk_*.json
graphify-out/cache/
